			]
			title: "The project begins"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["284FF001F6EB9649"]
			description: [
				"&l&8[&6PROJECT-MANAGER&8]"
				""
				"If you have any hope of surviving, you will need to get used to getting resources in bulk. It's also a good idea to gather more then quests require as you move forwards. Economies of scale is your friend. If you do this quest before mining, you can craft yourself some nice tools for the journey. "
			]
			icon: "minecraft:sugar_cane"
			id: "0436F7B60BDEB091"
			rewards: [{
				count: 24
				id: "2D2C971E9E651C2C"
				item: "minecraft:iron_ingot"
				type: "item"
			}]
			shape: "rsquare"
			size: 0.66d
			subtitle: "Its only the start..."
			tasks: [
				{
					consume_items: true
					count: 8L
					id: "37DD7A28A3A7CB26"
					item: "minecraft:sugar_cane"
					type: "item"
				}
