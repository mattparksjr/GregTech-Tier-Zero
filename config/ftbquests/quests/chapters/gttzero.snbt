		{
			dependencies: ["25289F9E8AE01C29"]
			description: [
				"&l&8[&6PROJECT-MANAGER&8]"
				""
				"First order of business is getting yourself &9settled.&r First grab some logs, and make a crafting table."
				""
				"The flint? Find some &7gravel&r or go loot some. Take this time to explore and maybe find your &abase&r of operations."
				""
				"&o&8Tip: Eating &bunique&r &8foods increases your total health pool!&r&r"
			]
			icon: "minecraft:oak_log"
			id: "0EAF2C5B5EB755C5"
			rewards: [{
				count: 2
				id: "0C609F96BBD85AA0"
				item: "delightful:cactus_steak"
				type: "item"
			}]
			shape: "rsquare"
			size: 0.75d
			subtitle: "We all gotta start somewhere right?"
			tasks: [
				{
					count: 6L
